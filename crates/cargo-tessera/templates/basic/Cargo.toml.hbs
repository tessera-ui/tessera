[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["rlib", "cdylib"]
name = "{{project_name_snake}}_lib"
path = "src/lib.rs"

[[bin]]
name = "{{project_name_snake}}"
path = "src/main.rs"

[dependencies]
tessera-ui = "{{versions.tessera_ui}}"
tessera-components = "{{versions.tessera_components}}"

[target.'cfg(target_family = "wasm")'.dependencies]
wasm-bindgen = "0.2.130"

[build-dependencies]
tessera-build = "{{versions.tessera_build}}"
