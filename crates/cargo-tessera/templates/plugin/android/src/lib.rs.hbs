use tessera_ui::{Plugin, with_plugin};

#[cfg(target_os = "android")]
use tessera_ui::{
    PluginContext,
    android::{activity, ActivityRef},
};

#[cfg(target_os = "android")]
tessera_ui::android::jni_bind! {
    class "{{android.package}}.HelloPlugin" as HelloPluginJni {
        fn hello(activity: ActivityRef) -> String;
    }
}

pub struct HelloPlugin {
    message: String,
}

impl HelloPlugin {
    pub fn new(message: impl Into<String>) -> Self {
        Self {
            message: message.into(),
        }
    }
}

impl Default for HelloPlugin {
    fn default() -> Self {
        Self::new(format!("Hello from {{project_name}}"))
    }
}

impl Plugin for HelloPlugin {}

/// Returns the registered plugin's message.
pub fn message() -> Option<String> {
    with_plugin(|plugin: &mut HelloPlugin| plugin.message.clone())
}

/// Calls the Kotlin side of the plugin while the app is resumed.
#[cfg(target_os = "android")]
pub fn hello_from_kotlin() -> Option<String> {
    let context = PluginContext::current()?;
    let android_app = context.android_app();
    match HelloPluginJni::hello(android_app, activity(android_app)) {
        Ok(value) => Some(value),
        Err(err) => {
            eprintln!("JNI call failed: {err}");
            None
        }
    }
}
