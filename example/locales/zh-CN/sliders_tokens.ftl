ui-slider = 滑块

ui-slider-size-xsmall = 滑块 - 尺寸 - 超小号

ui-slider-size-small = 滑块 - 尺寸 - 小号

ui-slider-size-medium = 滑块 - 尺寸 - 中号

ui-slider-size-large = 滑块 - 尺寸 - 大号

ui-slider-size-xlarge = 滑块 - 尺寸 - 超大号

ui-active-track = 活动轨道

ui-inactive-track = 非活动轨道

ui-switch-between-common-slider-tokens-and-the-five-size-token-sets = 在通用滑块令牌和五种尺寸令牌集之间切换。

ui-slider-token-set-selector = 滑块令牌集选择器

ui-vertical = 垂直

