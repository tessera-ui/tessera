<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tessera.example.test">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />
    <application android:hasCode="true">
        <service
            android:name="com.tessera.example.PlatformViewAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
    </application>
    <instrumentation
        android:name="com.tessera.example.PlatformViewAccessibilityTest"
        android:targetPackage="com.tessera.example" />
</manifest>
