<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{{project_name}}</title>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #000;
        user-select: none;
        -webkit-user-select: none;
      }

      canvas,
      canvas:focus,
      canvas:focus-visible {
        display: block;
        width: 100%;
        height: 100%;
        outline: none;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
      }

      /* Loader shown until the wasm bundle finishes loading. The bar animates
         indefinitely so the page never looks frozen during a large wasm
         download plus instantiation. */
      #tessera-loading {
        position: fixed;
        inset: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        transition: opacity 200ms ease-out;
      }

      #tessera-loading.tessera-loading-done {
        opacity: 0;
        pointer-events: none;
      }

      .tessera-loading-track {
        position: relative;
        width: min(240px, 60vw);
        height: 4px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.18);
      }

      .tessera-loading-bar {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 40%;
        border-radius: 999px;
        background: #fff;
        animation: tessera-loading-slide 1.1s cubic-bezier(0.65, 0, 0.35, 1)
          infinite;
      }

      @keyframes tessera-loading-slide {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .tessera-loading-bar {
          animation-duration: 2.4s;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="{{lib_name}}"></canvas>
    <div id="tessera-loading">
      <div class="tessera-loading-track">
        <div class="tessera-loading-bar"></div>
      </div>
    </div>
    <script type="module">
      import init from "./pkg-web/{{lib_name}}.js";

      const loading = document.getElementById("tessera-loading");

      try {
        await init();
        loading.classList.add("tessera-loading-done");
        loading.addEventListener("transitionend", () => loading.remove(), {
          once: true,
        });
      } catch (error) {
        // Keep the bar animating on failure so the page still reads as busy.
        console.error(error);
      }
    </script>
  </body>
</html>
